class Solution {
    public int findKthLargest(int[] nums, int k) {

        int[] count = new int[20001];

        // Counts how many times each number appears
        for (int num : nums) {
            count[num + 10000]++;
        }

        // Starting from the largest possible number
        for (int i = 20000; i >= 0; i--) {

            k -= count[i];

            if (k <= 0) {
                return i - 10000;
            }
        }

        return -1;
    }
} 
